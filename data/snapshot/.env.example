# --- dev DB 접속 정보 ---
# data/mock-loader/.env 에서 그대로 복사해도 된다.
DEV_DB_HOST=k14a103.p.ssafy.io
DEV_DB_PORT=5432
DEV_DB_NAME=running
DEV_DB_USERNAME=root
DEV_DB_PASSWORD=

# --- 로컬 실행 환경 ---
# pg_dump / psql 을 실행할 로컬 docker 컨테이너 이름.
# docker-compose 의 PostGIS 컨테이너를 그대로 재사용하면 별도 설치 불필요.
LOCAL_PG_CONTAINER=localPostgis
